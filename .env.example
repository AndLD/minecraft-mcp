# Minecraft server (a LAN world: host is localhost, the port is shown after "Open to LAN").
MC_HOST=localhost
# Optional: when empty, the port is discovered from the LAN world broadcast.
MC_PORT=
MC_VERSION=1.21.1
MC_USERNAME=ClaudeBot
# offline (LAN / cracked launchers) or microsoft
MC_AUTH=offline
# Your in-game name. If set, only your chat is treated as instructions.
MC_OWNER=Andrey_Knight
MC_AUTO_CONNECT=false

# Per-world state lives in DATA_DIR/<profile>/.
DATA_DIR=./data
# Fallback profile name, used only when the world cannot be identified automatically.
WORLD_PROFILE=

# Health points (of 20) at or below which the bot flees from any threat.
LOW_HEALTH_THRESHOLD=8
# debug | info | warn | error (logs go to stderr)
LOG_LEVEL=info
