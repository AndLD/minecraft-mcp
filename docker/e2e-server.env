# Minecraft server used by the e2e tests (image itzg/minecraft-server, Paper). The version defaults to 1.21.1;
# set MC_VERSION in the environment to run the e2e suite against another one.
# Read by the Jest global setup (test/e2e/support) and by docker-compose.e2e.yml, so there is one source of truth.
# The RCON password is only for a throwaway container on random local ports; it is not a secret.
EULA=TRUE
TYPE=PAPER
VERSION=1.21.1
ONLINE_MODE=FALSE
ENFORCE_SECURE_PROFILE=FALSE
MODE=survival
DIFFICULTY=peaceful
LEVEL_TYPE=minecraft:flat
# Superflat: bedrock at y=-64, two dirt layers, grass at y=-61, so players stand at y=-60.
GENERATOR_SETTINGS={"biome":"minecraft:plains","layers":[{"block":"minecraft:bedrock","height":1},{"block":"minecraft:dirt","height":2},{"block":"minecraft:grass_block","height":1}],"structure_overrides":[]}
GENERATE_STRUCTURES=false
SPAWN_PROTECTION=0
# Must stay true: with false the server removes animals, even ones summoned by a test. Tests stop natural
# spawning with the doMobSpawning game rule and clear the arena instead.
SPAWN_ANIMALS=true
# Must stay true, like SPAWN_ANIMALS: with false the server removes hostile mobs, even ones summoned by a test.
# Tests stop natural spawning with the doMobSpawning game rule and stay on peaceful unless a test needs monsters.
SPAWN_MONSTERS=true
SPAWN_NPCS=false
ALLOW_NETHER=false
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MAX_PLAYERS=10
ENABLE_RCON=true
RCON_PASSWORD=e2e-only-password
MEMORY=1G
MOTD=minecraft-mcp e2e
LEVEL=e2e-world
# Where itzg puts the files from /config (bukkit.yml must land in /data, not /data/config).
COPY_CONFIG_DEST=/data
